# ─── Server ─────────────────────────────────────────────────────────────────
# Port the Express server listens on (default: 8000)
PORT=8000

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Local development
MONGO_URI=mongodb://localhost:27017/videostream-ids

# Atlas example (replace with your own connection string)
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/videostream-ids

# ─── ML / AI API ─────────────────────────────────────────────────────────────
# URL of the Python Flask ML API (see ml_model/api_server.py)
ML_API_URL=http://localhost:5001

# ─── Blockchain (optional) ────────────────────────────────────────────────────
# Set these only if you deploy AlertRegistry.sol to a real network
# BLOCKCHAIN_CONTRACT_ADDRESS=0xYourContractAddressHere
# BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/<YOUR_PROJECT_ID>
# BLOCKCHAIN_PRIVATE_KEY=0xYourPrivateKeyHere  # NEVER commit real keys!
